# --- Obligatorias (todos los scripts) ---
# Endpoint del proyecto en Azure AI Foundry, terminado en /openai/v1
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=TU-API-KEY
# Modelo por defecto (Responses API) para 1-01 a 1-07
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Chain of responsibility con Decisions API (1-05-01, 1-05-02) ---
# Modelo que redacta las respuestas (Responses API); si falta usa AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_RESPONSES_DEPLOYMENT=gpt-6-luna
# Clasificador de la Decisions API: solo admite gpt-6-luna
AZURE_OPENAI_DECISIONS_DEPLOYMENT=gpt-6-luna

# --- Opcionales ---
# Recurso distinto para la Decisions API; si faltan usa AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY
# AZURE_OPENAI_DECISIONS_ENDPOINT=https://OTRO-RECURSO.services.ai.azure.com/openai/v1
# AZURE_OPENAI_DECISIONS_API_KEY=OTRA-API-KEY
# Ventana de contexto para el compactador de 1-02-01 (por defecto 128000)
# AZURE_OPENAI_CONTEXT_WINDOW=128000
